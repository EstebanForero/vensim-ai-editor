# Configuration for the CLI (apps/cli). Copy to `.env` — which is gitignored — and fill in.
#
# The command reads the nearest `.env` at or above the directory it is run from, stopping at the top
# of the repository, so one at the repository root covers both `bun run generate` and `bun start`
# (which runs from apps/cli). Anything the environment already sets wins over this file: an exported
# key, or one passed inline, is a decision about that run rather than a default.
#
# The editor in the browser does not read this file. Its key is a field in the AI Chat tab, kept in
# localStorage.

# Which provider: OpenAI, DeepSeek, Google Gemini, OpenRouter, Ollama (local) or Custom.
VENSIM_AI_PROVIDER=deepseek

# The key. VENSIM_AI_API_KEY is the provider-agnostic one; each provider also has its own variable
# (OPENAI_API_KEY, DEEPSEEK_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY), which is the one to use if
# your shell already exports it for other tools. Ollama serves locally and needs none — but it does
# need a variable to be *set*, even if empty, because "unset" is what an error is made of.
#
# Without VENSIM_AI_PROVIDER, this key goes to OpenAI's endpoint (see above).
# VENSIM_AI_API_KEY=sk-...

# Optional: which model, which endpoint, and how hard it should think (low, medium, high — sent
# only for models that take it).
# VENSIM_AI_MODEL=deepseek-chat
# VENSIM_AI_BASE_URL=https://api.deepseek.com/v1
# VENSIM_AI_REASONING=high
