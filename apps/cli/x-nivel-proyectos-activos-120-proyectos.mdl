{UTF-8}
Proyectos activos= INTEG (
	"Tasa inscripcion regular" -"Tasa de graduacion e independencia" -"Tasa de abandono o quiebra",
		120)
	~	Proyectos
	~	Numero de proyectos actualmente activos en la cartera.
	|

Tasa inscripcion regular= 25
	~	Proyectos/Month
	~	Flujo de entrada: proyectos nuevos que se inscriben a la cartera a tasa regular constante.
	|

Tasa de graduacion e independencia= MIN(Proyectos activos * Tasa graduacion, Mentoria sobre el costo requerido)
	~	Proyectos/Month
	~	Flujo de salida: proyectos que completan su ciclo y se graduan. Limitado por la capacidad de mentoria (presupuesto).
	|

Tasa de abandono o quiebra= Proyectos activos * Razon riesgo quiebra
	~	Proyectos/Month
	~	Flujo de salida: proyectos que abandonan o quiebran. Proporcional al numero de proyectos activos.
	|

Tasa graduacion= 0.2
	~	1/Month
	~	Fraccion mensual de proyectos activos que completan su ciclo y se graduan / se independizan.
	|

Presupuesto mensual= 150000000
	~	Presupuesto/Month
	~	Presupuesto disponible por mes para sostener la mentoria de proyectos.
	|

Mentoria sobre el costo requerido= Presupuesto mensual / "Costo de mentoria por proyectos"
	~	Proyectos/Month
	~	Capacidad de mentoria: cuantos proyectos puede sostener el presupuesto mensual dado el costo requerido por proyecto.
	|

Costo de mentoria por proyectos= 1000
	~	Presupuesto/Proyectos
	~	Costo requerido de mentoria por proyecto activo.
	|

Costo operativo= 1.5
	~	Presupuesto/Proyectos
	~	Costo operativo por proyecto (en millones de unidades de presupuesto).
	|

Razon riesgo quiebra= IF THEN ELSE(Proyectos activos > 200, 0.2, 0.1)
	~	1/Month
	~	Razon mensual de riesgo de quiebra / abandono por proyecto activo.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME= 100
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME= 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER= TIME STEP
	~	Month
	~	The frequency with which output is stored.
	|

TIME STEP= 0.25
	~	Month
	~	The time step for the simulation.
	|

