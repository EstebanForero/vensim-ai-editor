{UTF-8}
Inventario de bicicletas= INTEG (
	"Recepción de bicicletas" -"Venta de bicicletas",
		60)
	~	bicicletas
	~	Cantidad de bicicletas disponibles en la tienda
	|

Recepción de bicicletas= "Pedido de bicicletas" / "Tiempo de entrega"
	~	bicicletas/día
	~	Entrada de bicicletas desde el proveedor
	|

Venta de bicicletas= MIN("Demanda de bicicletas", "Inventario de bicicletas" / 1)
	~	bicicletas/día
	~	Salida por ventas; no puede superar el inventario disponible
	|

Pedido de bicicletas= MAX(0, ("Inventario deseado" - "Inventario de bicicletas") / "Tiempo de ajuste de inventario")
	~	bicicletas/día
	~	Cantidad solicitada al proveedor; no puede ser negativa
	|

Inventario deseado= 100
	~	bicicletas
	~	
	|

Tiempo de entrega= 5
	~	días
	~	
	|

Tiempo de ajuste de inventario= 10
	~	días
	~	
	|

Demanda de bicicletas= 8
	~	bicicletas/día
	~	
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME= 60
	~	días
	~	The final time for the simulation.
	|

INITIAL TIME= 0
	~	días
	~	The initial time for the simulation.
	|

SAVEPER= TIME STEP
	~	días
	~	The frequency with which output is stored.
	|

TIME STEP= 0.25
	~	días
	~	The time step for the simulation.
	|

