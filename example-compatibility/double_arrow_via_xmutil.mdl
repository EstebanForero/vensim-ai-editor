{UTF-8}
Demanda de bicicletas = 8
	~	bicicletas/día
	~	
	|
Inventario de bicicletas = INTEG(Recepción de bicicletas -\
		 Venta de bicicletas, 60)
	~	bicicletas
	~	Cantidad de bicicletas disponibles en la tienda
	|
Inventario deseado = 100
	~	bicicletas
	~	
	|
Pedido de bicicletas = MAX(0, (Inventario deseado - Inventario de bicicletas) /\
		 Tiempo de ajuste de inventario)
	~	bicicletas/día
	~	Cantidad solicitada al proveedor; no puede ser negativa
	|
Recepción de bicicletas = Pedido de bicicletas / Tiempo de entrega
	~	bicicletas/día
	~	Entrada de bicicletas desde el proveedor
	|
Tiempo de ajuste de inventario = 10
	~	días
	~	
	|
Tiempo de entrega = 5
	~	días
	~	
	|
Venta de bicicletas = MIN(Demanda de bicicletas, Inventario de bicicletas / 1)
	~	bicicletas/día
	~	Salida por ventas; no puede superar el inventario disponible
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|
INITIAL TIME = 0
	~	
	~	
	|
FINAL TIME = 60
	~	
	~	
	|
TIME STEP = 0.25
	~	
	~	
	|
SAVEPER = 0.25
	~	
	~	
	|
