{UTF-8}
Deposito A= INTEG (
	"Entrada A" -"Salida A",
		1000)
	~	m3
	~	
	|

Deposito B= INTEG (
	"Entrada B" -"Salida B",
		1000)
	~	m3
	~	
	|

Deposito C= INTEG (
	"Entrada C" -"Salida C",
		1000)
	~	m3
	~	
	|

Deposito D= INTEG (
	"Entrada D" -"Salida D",
		1000)
	~	m3
	~	
	|

Entrada A= Regeneracion
	~	m3/Month
	~	
	|

Salida A= Consumo A
	~	m3/Month
	~	
	|

Entrada B= Regeneracion
	~	m3/Month
	~	
	|

Salida B= Consumo B
	~	m3/Month
	~	
	|

Entrada C= Regeneracion
	~	m3/Month
	~	
	|

Salida C= Consumo C
	~	m3/Month
	~	
	|

Entrada D= Regeneracion
	~	m3/Month
	~	
	|

Salida D= Consumo D
	~	m3/Month
	~	
	|

Regeneracion= 100
	~	m3/Month
	~	
	|

Unidad de tiempo= 1
	~	Month
	~	Constante de valor 1 con unidades de tiempo: hace adimensional el argumento del lookup sin cambiar su valor.
	|

Unidad de volumen= 1
	~	m3
	~	La misma idea para un nivel de stock (o cualquier otra entrada dimensionada).
	|

Demanda en el tiempo(
	[(0,40)-(80,150)],
	(0,40),(40,95),(80,150))
	~	m3/Month
	~	Demanda individual creciente en el tiempo (eje X = meses).
	|

Demanda segun nivel(
	[(0,40)-(1000,150)],
	(0,40),(500,95),(1000,150))
	~	m3/Month
	~	Demanda individual creciente con el nivel del deposito (eje X = m3).
	|

Consumo A= Demanda en el tiempo(Time)
	~	m3/Month
	~	AVISO ESPERADO: argumento dimensionado (Time, en Month).
	|

Consumo B= Demanda en el tiempo(Time / Unidad de tiempo)
	~	m3/Month
	~	LIMPIO: adimensional, y vale lo mismo porque el divisor es 1.
	|

Consumo C= Demanda segun nivel(Deposito C)
	~	m3/Month
	~	AVISO ESPERADO: argumento dimensionado (un nivel, en m3).
	|

Consumo D= Demanda segun nivel(Deposito D / Unidad de volumen)
	~	m3/Month
	~	LIMPIO: adimensional, mismo valor.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME= 80
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME= 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER= TIME STEP
	~	Month
	~	The frequency with which output is stored.
	|

TIME STEP= 0.25
	~	Month
	~	The time step for the simulation.
	|

