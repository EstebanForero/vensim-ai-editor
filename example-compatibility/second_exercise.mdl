{UTF-8}
Suscriptores= INTEG (
	"Adquisicion de suscriptores" -"Cancelacion de suscriptores",
		1000)
	~	suscriptores
	~	
	|

Adquisicion de suscriptores= Efecto de recomendación + Efectividad de marketing
	~	suscriptores/mes
	~	
	|

Cancelacion de suscriptores= Suscriptores * Tasa de cancelación
	~	suscriptores/mes
	~	
	|

Tasa de recomendacion= 0.02
	~	1/mes
	~	
	|

Tasa de cancelacion= 0.05
	~	1/mes
	~	
	|

Presupuesto de marketing= 5000
	~	um/mes
	~	
	|

Efecto de recomendacion= Suscriptores * Tasa de recomendación
	~	suscriptores/mes
	~	
	|

Efectividad de marketing= Presupuesto de marketing / Costo de adquisición por suscriptor
	~	suscriptores/mes
	~	
	|

Costo de adquisicion por suscriptor= 50
	~	um/suscriptores
	~	
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME= 100
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME= 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER= TIME STEP
	~	Month
	~	The frequency with which output is stored.
	|

TIME STEP= 0.25
	~	Month
	~	The time step for the simulation.
	|

