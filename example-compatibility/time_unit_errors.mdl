{UTF-8}
Agua_disponible= INTEG (
	Regeneracion -Extraccion_A -Extraccion_B,
		600)
	~	m3
	~	Volumen de agua en el deposito compartido
	|

Regeneracion= 15
	~	m3/Month
	~	Regeneracion periodica del deposito de agua
	|

Extraccion_A= Demanda_A
	~	m3/Month
	~	Extraccion de agua realizada por el agricultor A
	|

Extraccion_B= Demanda_B
	~	m3/Month
	~	Extraccion de agua realizada por el agricultor B
	|

Demanda_A= Demanda_inicial + Crecimiento_demanda * Time
	~	m3/Month
	~	Demanda de agua del agricultor A creciente con el tiempo
	|

Demanda_B= Demanda_inicial + Crecimiento_demanda * Time
	~	m3/Month
	~	Demanda de agua del agricultor B creciente con el tiempo
	|

Demanda_inicial= 5
	~	m3/Month
	~	Consumo inicial de agua de cada agricultor
	|

Crecimiento_demanda= 0.15
	~	m3/Month/Month
	~	Cuanto crece el consumo de cada agricultor cada mes
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME= 80
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME= 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER= TIME STEP
	~	Month
	~	The frequency with which output is stored.
	|

TIME STEP= 0.25
	~	Month
	~	The time step for the simulation.
	|

