{UTF-8}
Agua disponible= INTEG (
	Regeneracion -Extraccion_A -Extraccion_B,
		600)
	~	m3
	~	Volumen de agua almacenado en el deposito compartido por ambos agricultores
	|

Regeneracion= 15
	~	m3/Month
	~	Recarga natural periodica del deposito de agua
	|

Extraccion_A= Demanda_A
	~	m3/Month
	~	Consumo o extraccion de agua por el agricultor A
	|

Extraccion_B= Demanda_B
	~	m3/Month
	~	Consumo o extraccion de agua por el agricultor B
	|

Demanda_A= 5 + 0.15 * Time
	~	m3/Month
	~	Demanda de agua del agricultor A que crece con el tiempo
	|

Demanda_B= 5 + 0.15 * Time
	~	m3/Month
	~	Demanda de agua del agricultor B que crece con el tiempo
	|

Extraccion_total= Extraccion_A + Extraccion_B
	~	m3/Month
	~	Suma de las extracciones de agua de ambos agricultores
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME= 80
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME= 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER= TIME STEP
	~	Month
	~	The frequency with which output is stored.
	|

TIME STEP= 0.25
	~	Month
	~	The time step for the simulation.
	|

